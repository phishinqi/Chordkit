{
  "name": "@phishinqi/chordkit",
  "version": "0.1.1",
  "description": "Register-aware chord analysis for TypeScript",
  "license": "GPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./legacy": {
      "types": "./dist/legacy.d.ts",
      "import": "./dist/legacy.js",
      "require": "./dist/legacy.cjs"
    },
    "./midi": {
      "types": "./dist/midi.d.ts",
      "import": "./dist/midi.js",
      "require": "./dist/midi.cjs"
    },
    "./pipeline": {
      "types": "./dist/pipeline.d.ts",
      "import": "./dist/pipeline.js",
      "require": "./dist/pipeline.cjs"
    },
    "./harmony": {
      "types": "./dist/harmony.d.ts",
      "import": "./dist/harmony.js",
      "require": "./dist/harmony.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:legacy": "vitest run tests/legacy.test.ts",
    "ci": "npm run typecheck && npm run test:coverage",
    "playground:dev": "vite --config playground/vite.config.ts",
    "playground:check": "tsc -p playground/tsconfig.json --noEmit",
    "playground:test": "vitest run --config playground/vitest.config.ts",
    "playground:build": "npm run playground:check && vite build --config playground/vite.config.ts",
    "playground:preview": "vite preview --config playground/vite.config.ts"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "fast-check": "^4.2.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phishinqi/Chordkit.git"
  },
  "bugs": {
    "url": "https://github.com/phishinqi/Chordkit/issues"
  },
  "homepage": "https://github.com/phishinqi/Chordkit#readme"
}
